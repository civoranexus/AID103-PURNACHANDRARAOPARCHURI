# Environment Configuration Template
# Copy this to .env file and fill in your values

# ============================================
# DJANGO CONFIGURATION
# ============================================
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local SQLite (leave empty to use default)
# DATABASE_URL=

# For PostgreSQL (example):
# DATABASE_URL=postgres://user:password@localhost:5432/cropguard_db

# For MySQL (example):
# DATABASE_URL=mysql://user:password@localhost:3306/cropguard_db

# ============================================
# API KEYS
# ============================================
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
WEATHERAPI_API_KEY=your-weatherapi-api-key

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,file://

# ============================================
# JWT CONFIGURATION
# ============================================
ACCESS_TOKEN_LIFETIME=3600
REFRESH_TOKEN_LIFETIME=604800

# ============================================
# FLASK ML SERVICE
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
